<% layout("/layouts/boilerplate") %>
<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">
            <i class="fa-solid fa-key"></i>
        </div>
        <h1 class="auth-title">Verify OTP</h1>
        <p class="auth-subtitle">Enter the 6-digit code sent to your email.</p>
        
        <form action="/verify-reset-otp" method="post" class="needs-validation" novalidate>
            <div class="mb-4">
                <input name="otp" type="text" class="form-control auth-input" placeholder="6-digit OTP" required id="otp" maxlength="6">
                <div class="invalid-feedback">Please enter a valid OTP.</div>
            </div>
            
            <button class="auth-btn">Verify Code</button>
        </form>

        <div class="auth-divider">or</div>

        <form action="/forgot-password" method="POST" class="mt-2 text-center">
            <span class="text-muted" style="font-size: 0.9rem;">Didn't receive the code? </span>
            <input type="hidden" name="email" value="<%= locals.resetEmail || '' %>">
            <button type="submit" class="btn btn-link p-0 pb-1 text-decoration-none" style="color: #fe424d; font-weight: 600; border: none; background: none; font-size: 0.9rem;">Resend OTP</button>
        </form>
    </div>
</div>
