<% layout("/layouts/boilerplate") %>
<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">
            <i class="fa-solid fa-lock"></i>
        </div>
        <h1 class="auth-title">Forgot Password</h1>
        <p class="auth-subtitle">Enter your email to receive a password reset code.</p>
        
        <form action="/forgot-password" method="post" class="needs-validation" novalidate>
            <div class="mb-4">
                <input name="email" type="email" class="form-control auth-input" placeholder="Registered Email" required id="email">
                <div class="invalid-feedback">Please enter a valid email.</div>
            </div>
            
            <button class="auth-btn">Send Reset Code</button>
        </form>

        <div class="auth-divider">or</div>

        <div class="auth-footer">
            Remember your password? <a href="/login" class="auth-link">Login</a>
        </div>
    </div>
</div>
