<% layout("/layouts/boilerplate") %>
<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">
            <i class="fa-regular fa-compass"></i>
        </div>
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Continue your journey with WanderNest.</p>
        
        <form action="/login" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
                <input name="username" type="text" class="form-control auth-input" placeholder="Username" required id="username">
            </div>

            <div class="mb-4">
                <input name="password" type="password" class="form-control auth-input" placeholder="Password" required id="password">
            </div>
            
            <a href="/forgot-password" class="auth-link auth-forgot">Forgot Password?</a>

            <button class="auth-btn">Login</button>
        </form>

        <div class="auth-divider">or</div>

        <div class="auth-footer">
            Don't have an account? <a href="/signup" class="auth-link">Create Account</a>
        </div>
    </div>
</div>