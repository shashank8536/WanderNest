<% layout("/layouts/boilerplate") %>
<div class="auth-wrapper">
    <div class="auth-card">
        <div class="auth-logo">
            <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h1 class="auth-title">Reset Password</h1>
        <p class="auth-subtitle">Create a new, strong password.</p>
        
        <form action="/reset-password" method="post" class="needs-validation" novalidate>
            <div class="mb-3">
                <input name="password" type="password" class="form-control auth-input" placeholder="New Password" required id="password">
                <div class="invalid-feedback">Please enter a new password.</div>
            </div>

            <div class="mb-4">
                <input name="confirmPassword" type="password" class="form-control auth-input" placeholder="Confirm Password" required id="confirmPassword">
                <div class="invalid-feedback">Please confirm your new password.</div>
            </div>
            
            <button class="auth-btn">Update Password</button>
        </form>
    </div>
</div>
