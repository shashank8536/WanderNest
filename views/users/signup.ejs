<% layout("/layouts/Boilerplate") %>
    <div class="auth-wrapper">
        <div class="auth-card">
            <div class="auth-logo">
                <i class="fa-regular fa-compass"></i>
            </div>
            <h1 class="auth-title">Create your WanderNest Account</h1>
            <p class="auth-subtitle">Start exploring amazing destinations.</p>

            <form action="/signup" method="post" class="needs-validation" novalidate>
                <div class="mb-3">
                    <input name="username" type="text" class="form-control auth-input" placeholder="Username" required
                        id="username">
                </div>

                <div class="mb-3">
                    <input name="email" type="email" class="form-control auth-input" placeholder="Email" required
                        id="email">
                </div>

                <div class="mb-4">
                    <input name="password" type="password" class="form-control auth-input" placeholder="Password"
                        required id="password">
                </div>

                <button class="auth-btn">Create Account</button>
            </form>

            <div class="auth-divider">or</div>

            <div class="auth-footer">
                Already have an account? <a href="/login" class="auth-link">Login</a>
            </div>
        </div>
    </div>