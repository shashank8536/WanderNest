<% layout("layouts/Boilerplate") %>
    <script>
        const mapToken = "<%= process.env.MAP_TOKEN %>";
        const listing = <% - JSON.stringify(listing) %>;
    </script>
    <div class="row mt-3">
        <!-- Title -->
        <div class="col-12 col-md-10 offset-md-1 offset-lg-2 col-lg-8">
            <h3>
                <%= listing.title %>
            </h3>
        </div>

        <!-- Left side: Listing details card -->
        <div class="col-12 col-md-10 col-lg-5 offset-md-1 offset-lg-2">
            <div class="card show-card listing-card border-0">
                <img src="<%= listing.image.url %>" class="card-img-top show-img rounded-4" alt="listing_image">
                <div class="card-body px-0 pt-3">
                    <p class="card-text">Owned by: <i>
                            <%= listing.owner.username %>
                        </i></p>
                    <hr>
                    <p class="card-text fs-5">
                        <%= listing.description %>
                    </p>
                    <hr>
                    <p class="card-text"><i class="fa-solid fa-location-dot"></i> &nbsp;<%= listing.location %>, <%=
                                listing.country %>
                    </p>
                    <p class="card-text text-muted mt-2"><i class="fa-solid fa-users"></i> &nbsp;Max <%= listing.maxGuests || 4 %> Guests</p>
                </div>
            </div>

            <!-- btns (Edit / Delete) inside listing details column -->
            <% if(currUser && listing.owner._id.equals(currUser._id)) {%>
                <div class="btns d-flex gap-3 mb-4">
                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn px-4 rounded-3">Edit</a>
                    <form action="/listings/<%= listing._id %>?_method=DELETE" method="post" class="m-0">
                        <button class="btn btn-dark px-4 rounded-3">Delete</button>
                    </form>
                </div>
                <% } %>
        </div>

        <!-- Right side: Sticky Booking Widget -->
        <div class="col-12 col-md-10 col-lg-3 offset-md-1 offset-lg-0 mb-4">
            <div class="card shadow border rounded-4 p-4 sticky-lg-top" style="top: 100px; z-index: 10;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="fs-4 fw-bold">₹<%= listing.price.toLocaleString("en-IN") %> <span
                                class="fs-6 fw-normal text-muted">/ night</span></span>
                </div>

                <form action="/listings/<%= listing._id %>/bookings" method="POST" class="needs-validation" novalidate>
                    <div class="border rounded-3 p-2 mb-3">
                        <div class="row g-0 border-bottom pb-2 mb-2">
                            <div class="col-6 border-end pe-2">
                                <label class="form-label text-uppercase fw-bold text-muted"
                                    style="font-size: 0.7rem; letter-spacing: 0.5px;">Check-In</label>
                                <input type="date" name="booking[checkIn]" id="checkIn"
                                    class="form-control border-0 p-0 shadow-none" required
                                    min="<%= new Date().toISOString().split('T')[0] %>">
                            </div>
                            <div class="col-6 ps-2">
                                <label class="form-label text-uppercase fw-bold text-muted"
                                    style="font-size: 0.7rem; letter-spacing: 0.5px;">Check-Out</label>
                                <input type="date" name="booking[checkOut]" id="checkOut"
                                    class="form-control border-0 p-0 shadow-none" required
                                    min="<%= new Date().toISOString().split('T')[0] %>">
                            </div>
                        </div>
                        <div>
                            <label class="form-label text-uppercase fw-bold text-muted"
                                style="font-size: 0.7rem; letter-spacing: 0.5px;">Guests</label>
                            <input type="number" name="booking[guests]" id="guests"
                                class="form-control border-0 p-0 shadow-none" required min="1" max="<%= listing.maxGuests || 4 %>" value="1">
                        </div>
                    </div>

                    <% if (currUser) { %>
                        <% if (listing.owner._id.equals(currUser._id)) { %>
                            <button type="button" class="btn btn-danger w-100 py-3 rounded-3 fw-bold disabled"
                                style="background-color: #fe424d; border: none; opacity: 0.7;">
                                You Own This Listing
                            </button>
                            <% } else { %>
                                <button type="submit" class="btn btn-danger w-100 py-3 rounded-3 fw-bold text-white"
                                    style="background-color: #fe424d; border: none;">
                                    Reserve
                                </button>
                                <% } %>
                                    <% } else { %>
                                        <a href="/login"
                                            class="btn btn-danger w-100 py-3 rounded-3 fw-bold text-center text-white text-decoration-none"
                                            style="background-color: #fe424d; border: none; display: block;">
                                            Log in to Book
                                        </a>
                                        <% } %>
                </form>

                <div id="bookingSummary" class="mt-3 d-none">
                    <div class="d-flex justify-content-between text-muted mb-2" style="font-size: 0.9rem;">
                        <span id="priceCalc">₹<%= listing.price.toLocaleString("en-IN") %> x 0 nights</span>
                        <span id="basePrice">₹0</span>
                    </div>
                    <div class="d-flex justify-content-between text-muted mb-2" style="font-size: 0.9rem;">
                        <span>WanderNest service fee</span>
                        <span>₹500</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total</span>
                        <span id="totalPrice">₹0</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reviews & Map Section (Stretches below details and booking widget) -->
        <div class="col-12 col-md-10 offset-md-1 col-lg-8 offset-lg-2">
            <hr>
            <% if(currUser) {%>
                <div class="mb-3">
                    <h4>Leave a Review</h4>
                    <form action="/listings/<%= listing._id %>/review" method="post" novalidate
                        class="needs-validation">
                        <div class="mb-3 mt-3">
                            <label for="Rating" class="form-label">Rating</label>
                            <fieldset class="starability-slot">
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1"
                                    checked aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>
                        </div>
                        <div class="mb-3 mt-3">
                            <label for="Comment" class="form-label">Comment</label>
                            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                                required></textarea>
                            <div class="invalid-feedback">
                                Please add some content for review
                            </div>
                        </div>
                        <button class="btn btn-outline-dark px-4 rounded-3">Submit</button>
                    </form>
                    <hr />
                </div>
                <% } %>

                    <% if(listing.reviews.length> 0) { %>
                        <div class="mb-3">
                            <p class="fs-5"><b>All Reviews</b></p>
                            <div class="row">
                                <% for(review of listing.reviews) { %>
                                    <div class="card col-12 col-md-5 ms-md-3 mb-3 border rounded-3 p-3">
                                        <div class="card-body p-0">
                                            <h5 class="card-title fw-bold">@<%= review.author.username %>
                                            </h5>
                                            <p class="starability-result" data-rating="<%= review.rating%>"></p>
                                            <p class="card-text">
                                                <%= review.comment %>
                                            </p>
                                            <form
                                                action="/listings/<%= listing._id %>/review/<%= review._id %>?_method=DELETE"
                                                method="post" class="mt-2 m-0">
                                                <button class="btn btn-sm btn-dark px-3 rounded-pill">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                            <hr>
                        </div>
                        <% } %>

                            <div class="mb-4">
                                <h3>Where you'll be</h3>
                                <div id="map" class="rounded-4 overflow-hidden mt-3 shadow-sm" style="height: 350px;">
                                </div>
                            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const checkInInput = document.getElementById("checkIn");
            const checkOutInput = document.getElementById("checkOut");
            const bookingSummary = document.getElementById("bookingSummary");
            const priceCalc = document.getElementById("priceCalc");
            const basePriceSpan = document.getElementById("basePrice");
            const totalPriceSpan = document.getElementById("totalPrice");

            const pricePerNight = <%= listing.price %>;

            function updateSummary() {
                const checkInDate = new Date(checkInInput.value);
                const checkOutDate = new Date(checkOutInput.value);

                if (checkInInput.value && checkOutInput.value && checkOutDate > checkInDate) {
                    const diffTime = Math.abs(checkOutDate - checkInDate);
                    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

                    const basePrice = pricePerNight * diffDays;
                    const serviceFee = 500;
                    const total = basePrice + serviceFee;

                    priceCalc.innerText = `₹${pricePerNight.toLocaleString("en-IN")} x ${diffDays} nights`;
                    basePriceSpan.innerText = `₹${basePrice.toLocaleString("en-IN")}`;
                    totalPriceSpan.innerText = `₹${total.toLocaleString("en-IN")}`;

                    bookingSummary.classList.remove("d-none");
                } else {
                    bookingSummary.classList.add("d-none");
                }
            }

            checkInInput.addEventListener("change", (e) => {
                checkOutInput.min = e.target.value;
                updateSummary();
            });

            checkOutInput.addEventListener("change", updateSummary);
        });
    </script>

    <script src="/css/js/map.js"></script>