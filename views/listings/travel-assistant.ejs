<% layout("layouts/Boilerplate") %>

  <link rel="stylesheet" href="/css/aiTravel.css">

  <!-- AI Loading Overlay -->
  <div id="aiLoadingOverlay" class="ai-loading-overlay" aria-hidden="true" role="status" aria-live="polite">
    <div class="ai-loading-card">
      <div class="ai-spinner" aria-hidden="true">
        <span></span>
      </div>
      <h2 class="ai-loading-title">WanderNest AI</h2>
      <p class="ai-loading-subtitle">Creating your personalized travel plan...</p>
      <p class="ai-loading-message" id="aiLoadingMessage">Checking live weather...</p>
    </div>
  </div>

  <div class="travel-assistant-container">

    <!-- Hero Section -->
    <section class="hero-section">
      <h1> WanderNest AI Travel Assistant</h1>
      <p>Plan your perfect trip with AI-powered itineraries, weather insights, packing recommendations, and personalized
        stay suggestions.</p>
    </section>

    <!-- Travel Planner Form -->
    <section class="mb-5">
      <div class="assistant-card">
        <form action="/travel-assistant/generate" method="post" id="travelForm">
          <div class="row g-4">

            <!-- Destination Input -->
            <div class="col-lg-3 col-md-6">
              <div class="form-group-custom">
                <label for="destination">Where to?</label>
                <div class="input-icon-wrapper">
                  <i class="fa-solid fa-location-dot"></i>
                  <input type="text" id="destination" name="destination" class="form-control form-control-custom"
                    placeholder="Tokyo, Japan" value="Tokyo, Japan">
                </div>
              </div>
            </div>

            <!-- Budget Select -->
            <div class="col-lg-4 col-md-6">
              <div class="form-group-custom">
                <label for="budget">Budget Range</label>
                <div class="input-icon-wrapper">
                  <i class="fa-solid fa-money-bill-wave"></i>
                  <select id="budget" name="budget" class="form-control form-control-custom">
                    <option value="budget">₹0 – ₹1,500 &nbsp;&nbsp; Budget</option>
                    <option value="moderate" selected>₹1,500 – ₹3,500 &nbsp;&nbsp; Moderate</option>
                    <option value="premium">₹3,500 – ₹7,000 &nbsp;&nbsp; Premium</option>
                    <option value="luxury">₹7,000+ &nbsp;&nbsp; Luxury</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Duration Select -->
            <div class="col-lg-2 col-md-6">
              <div class="form-group-custom">
                <label for="duration">Duration</label>
                <div class="input-icon-wrapper">
                  <i class="fa-solid fa-calendar-days"></i>
                  <select id="duration" name="duration" class="form-control form-control-custom">
                    <option value="3">3 Days</option>
                    <option value="5" selected>5 Days</option>
                    <option value="7">7 Days</option>
                    <option value="10">10 Days</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Travel Month Select -->
            <div class="col-lg-3 col-md-6">
              <div class="form-group-custom">
                <label for="travelMonth">Month of Travel</label>
                <div class="input-icon-wrapper">
                  <i class="fa-solid fa-calendar-check"></i>
                  <select id="travelMonth" name="month" class="form-control form-control-custom">
                    <option value="january">January</option>
                    <option value="february">February</option>
                    <option value="march">March</option>
                    <option value="april">April</option>
                    <option value="may">May</option>
                    <option value="june">June</option>
                    <option value="july">July</option>
                    <option value="august">August</option>
                    <option value="september">September</option>
                    <option value="october" selected>October</option>
                    <option value="november">November</option>
                    <option value="december">December</option>
                  </select>
                </div>
              </div>
            </div>

            <!-- Travel Type Pills -->
            <div class="col-12">
              <div class="form-group-custom mb-0">
                <label>Travel Type</label>
                <input type="hidden" name="travelType" id="travelTypeInput" value="couple">
                <div class="pill-container">
                  <button type="button" class="pill-btn" data-value="solo">Solo</button>
                  <button type="button" class="pill-btn active" data-value="couple">Couple</button>
                  <button type="button" class="pill-btn" data-value="family">Family</button>
                  <button type="button" class="pill-btn" data-value="friends">Friends</button>
                </div>
              </div>
            </div>

            <!-- Generate Button -->
            <div class="col-12 mt-4">
              <button type="submit" class="btn btn-generate w-100">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Generate Travel Plan
              </button>
              <p class="form-subtext"> AI uses weather forecasts, your budget, trip duration, and travel preferences to
                generate personalized recommendations.</p>
            </div>

          </div>
        </form>
      </div>
    </section>

    <!-- Output Section: Weather & Packing -->
    <section class="row g-4 mb-5">

      <!-- Weather Card -->
      <div class="col-lg-5">
        <div class="assistant-card weather-card-bg h-100" data-wx="clear">
          <div class="weather-card-content d-flex flex-column justify-content-between h-100 w-100">

            <!-- Top row: label + condition badge -->
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <p class="wx-label">Weather Forecast</p>
                <h3 id="weatherCity" class="wx-city">Tokyo, Japan</h3>
              </div>
              <div class="weather-badge">
                <span id="weatherCondition">Sunny</span>
              </div>
            </div>

            <!-- Bottom row: icon + temp on left, detail chips on right -->
            <div class="wx-bottom-row">
              <div class="wx-temp-row">
                <img id="weatherIcon"
                  class="wx-icon"
                  src="https://openweathermap.org/img/wn/01d@2x.png"
                  alt="Weather condition icon">
                <div>
                  <h2 id="weatherTemp" class="wx-temp">22°C</h2>
                  <p id="weatherDescription" class="wx-desc">Partly Sunny</p>
                </div>
              </div>

              <div class="wx-chips">
                <p id="weatherHumidity" class="wx-chip">Humidity: 0%</p>
                <p id="weatherWind" class="wx-chip">Wind: 0 m/s</p>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Packing Essentials Card -->
      <div class="col-lg-7">
        <div class="assistant-card h-100">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="h5 font-weight-bold mb-0" style="font-weight: 700;">
              <i class="fa-solid fa-clipboard-check text-danger me-2"></i> Packing Essentials
            </h3>
            <span class="pack-progress-badge">4/8 Packed</span>
          </div>
          <div class="packing-grid" id="packingGrid">

            <div class="packing-item-card checked">
              <input type="checkbox" id="pack1" checked>
              <span>Universal Adapter</span>
            </div>

            <div class="packing-item-card checked">
              <input type="checkbox" id="pack2" checked>
              <span>Comfortable Shoes</span>
            </div>

            <div class="packing-item-card">
              <input type="checkbox" id="pack3">
              <span>Portable Charger</span>
            </div>

            <div class="packing-item-card">
              <input type="checkbox" id="pack4">
              <span>Rain Shell Jacket</span>
            </div>

          </div>
        </div>
      </div>

    </section>

    <!-- Travel Advisory Warnings Section -->
    <section class="mb-5">
      <div class="assistant-card advisory-card">
        <h4><i class="fa-solid fa-triangle-exclamation"></i> Travel Advisory</h4>
        <div class="advisory-list" id="travelAdvisoryList">
          <div class="advisory-item">
            <p>Loading travel advisory...</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Itinerary Section -->
    <section class="itinerary-section mb-5">
      <h2>Your Itinerary</h2>
      <div class="timeline-container" id="timelineContainer">
      </div>
    </section>


    <!-- Recommended WanderNest Stays -->
    <section class="mb-5">
      <div class="section-title-wrapper d-flex justify-content-between align-items-center">
        <h2 class="mb-0">Recommended Stays for Your Trip</h2>
        <a href="/listings" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold">Explore More</a>
      </div>

      <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mt-1" id="recommendedStaysGrid">
      </div>
    </section>

    <!-- Smart Alternatives Section -->
    <section class="mb-5" id="travelInsightsSection" style="display:none;">
      <div class="section-title-wrapper d-flex justify-content-between align-items-center">
        <h2 id="travelInsightsTitle">
          Smart Alternatives
        </h2>
      </div>
      <p id="travelInsightsReason" class="text-muted mb-4"></p>
      <div class="row g-4" id="travelInsightsContainer">
      </div>
    </section>
  </div>

  <script defer src="/js/aiTravel.js"></script>