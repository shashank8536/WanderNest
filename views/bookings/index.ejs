<% layout("layouts/Boilerplate") %>
<div class="row mt-3">
    <div class="col-12 col-md-10 offset-md-1">
        <h3 class="mb-4">My Bookings</h3>

        <% if (bookings.length === 0) { %>
            <div class="text-center py-5 border rounded-4 bg-light shadow-sm">
                <i class="fa-regular fa-calendar-xmark text-muted mb-3" style="font-size: 3rem;"></i>
                <h5 class="text-muted fw-bold">No Bookings Found</h5>
                <p class="text-muted mb-4">You haven't reserved any stays yet. Let's find your next adventure!</p>
                <a href="/listings" class="btn btn-danger px-4 py-2 rounded-pill fw-bold text-white text-decoration-none" style="background-color: #fe424d; border: none;">
                    Explore Listings
                </a>
            </div>
        <% } else { %>
            <div class="row row-cols-1 row-cols-md-2 g-4">
                <% for (let booking of bookings) { %>
                    <div class="col">
                        <div class="card h-100 shadow-sm border rounded-4 overflow-hidden d-flex flex-column flex-md-row">
                            <div class="col-md-5" style="min-height: 180px; position: relative;">
                                <img src="<%= booking.listing.image.url %>" class="img-fluid w-100 h-100 object-fit-cover" alt="listing_image" style="position: absolute; top:0; left:0;">
                            </div>
                            <div class="col-md-7 d-flex flex-column">
                                <div class="card-body p-3 flex-grow-1">
                                    <h5 class="card-title fw-bold text-truncate mb-2">
                                        <a href="/listings/<%= booking.listing._id %>" class="text-decoration-none text-dark">
                                            <%= booking.listing.title %>
                                        </a>
                                    </h5>
                                    <p class="card-text text-muted mb-1 small">
                                        <i class="fa-solid fa-location-dot me-1"></i><%= booking.listing.location %>, <%= booking.listing.country %>
                                    </p>
                                    <hr class="my-2">
                                    <div class="row mb-2">
                                        <div class="col-6">
                                            <span class="text-uppercase text-muted fw-bold d-block" style="font-size: 0.65rem;">Check-in</span>
                                            <span class="small fw-semibold"><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                        </div>
                                        <div class="col-6">
                                            <span class="text-uppercase text-muted fw-bold d-block" style="font-size: 0.65rem;">Check-out</span>
                                            <span class="small fw-semibold"><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">
                                            <span class="text-uppercase text-muted fw-bold d-block" style="font-size: 0.65rem;">Guests</span>
                                            <span class="small fw-semibold"><%= booking.guests %> <%= booking.guests === 1 ? 'Guest' : 'Guests' %></span>
                                        </div>
                                        <div class="col-6">
                                            <span class="text-uppercase text-muted fw-bold d-block" style="font-size: 0.65rem;">Total Price</span>
                                            <span class="small fw-bold text-success">₹<%= booking.totalPrice.toLocaleString("en-IN") %></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-white border-top-0 p-3 pt-0">
                                    <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST" class="m-0">
                                        <button type="submit" class="btn btn-outline-danger btn-sm w-100 rounded-pill fw-bold" onclick="return confirm('Are you sure you want to cancel this booking?')">
                                            Cancel Reservation
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>
